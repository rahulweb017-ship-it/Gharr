# Gharr — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file is committed and must never contain secrets.

# ---------------------------------------------------------------------------
# Database — local PostgreSQL 17 (service: postgresql-x64-17)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/homeall?schema=public"
# Separate database used by the integration test suite; it is truncated freely.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/homeall_test?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me"
# Separate pepper for OTP hashing so rotating one does not invalidate the other.
OTP_PEPPER="replace-me"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# ---------------------------------------------------------------------------
# SMS / OTP delivery
# ---------------------------------------------------------------------------
# console = print the OTP to the server terminal (development).
# msg91 / twilio = real delivery, requires the credentials below.
SMS_PROVIDER="console"
# Returns the OTP in the API response for allowlisted dev numbers only.
# The app refuses to boot if this is true while NODE_ENV=production.
OTP_DEV_ECHO=true
DEV_PHONE_PREFIX="+9190000000"
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# cod    = cash on delivery only
# mock   = offline gateway with a dev Succeed/Fail page that posts a correctly
#          signed webhook, exercising the real production code path
# razorpay = live gateway (keys required)
PAYMENT_PROVIDER="mock"
MOCK_PAYMENT_SECRET="mock-webhook-secret"
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Platform economics (basis for the commission ledger)
# ---------------------------------------------------------------------------
MATERIAL_COMMISSION_PERCENT=8
LABOUR_COMMISSION_PERCENT=12
MAX_ORDER_PAISE=1000000000

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------
# Private documents (worker IDs, delivery proof) — never served from /public.
PRIVATE_STORAGE_DIR="./storage/private"
SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
DEFAULT_CITY="Hyderabad"
LOG_LEVEL="debug"
