# Base URL of the Gharr backend (no trailing slash, no /api/v1).
# Unset in development: the app guesses the Metro host's LAN IP on :3100,
# or 10.0.2.2:3100 on the Android emulator.
# Required for a standalone APK, e.g. this PC's Wi-Fi IP while testing:
# EXPO_PUBLIC_API_URL=http://192.168.1.43:3100
EXPO_PUBLIC_API_URL=
